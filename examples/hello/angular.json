{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "npm" },
  "newProjectRoot": ".",
  "projects": {
    "hello": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "web/src/main.ts",
            "index": "web/src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": { "base": "dist/web", "browser": "" },
            "styles": ["web/src/styles.css"],
            "polyfills": []
          },
          "configurations": {
            "production": { "outputHashing": "all", "optimization": true, "sourceMap": false },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
